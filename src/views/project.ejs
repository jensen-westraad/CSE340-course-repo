<%- include('partials/header') %>

    <h1>
        <%= project.title %>
    </h1>

    <p>
        <%= project.description %>
    </p>

    <p><strong>Date:</strong>
        <%= project.formatted_date %>
    </p>
    <p><strong>Location:</strong>
        <%= project.location %>
    </p>
    <p>
        <strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <% if (categories.length> 0) { %>
        <p>
            <strong>Categories:</strong>
            <% categories.forEach(category=> { %>
                <a href="/category/<%= category.category_id %>">
                    <%= category.name %>
                </a>
                <% }); %>
        </p>
        <% } %>
            <p>
                <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
            </p>
            <p>
                <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
            </p>


            <%- include('partials/footer') %>